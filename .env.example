# ============================================================
# CipherShield — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
# ============================================================

# ----------------------------------------------------------
# MongoDB
# ----------------------------------------------------------
# Local MongoDB: install MongoDB Community Server and keep this default.
# Render: paste your MongoDB Atlas connection string in MONGODB_URI.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ciphershield
JWT_SECRET=generate-a-long-random-secret-for-jwt-signing

# ----------------------------------------------------------
# Backend
# ----------------------------------------------------------
BACKEND_PORT=8000
SECRET_KEY=generate-a-secure-random-key-here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CIPHERSHIELD_DEBUG=true
ENVIRONMENT=development

# ----------------------------------------------------------
# Have I Been Pwned API
# ----------------------------------------------------------
HIBP_API_KEY=your-hibp-api-key

# ----------------------------------------------------------
# Email (SMTP — for breach alerts and notifications)
# ----------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@ciphershield.app

# ----------------------------------------------------------
# Frontend (Vite public env vars — VITE_ prefix required)
# ----------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=CipherShield
